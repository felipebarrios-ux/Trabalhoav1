@model trabalhoav1.Models.Cliente

@{
    Layout = "_Layout";
    var clientes = ViewBag.Clientes as IEnumerable<trabalhoav1.Models.Cliente>;
    bool eEdicao = Model != null && Model.Id > 0;
}

<div class="row g-4">
    <!-- Formulário em Card -->
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white fw-bold">
                @(eEdicao ? "Editar Cliente" : "Cadastrar Cliente")
            </div>
            <div class="card-body">
                <form action="/Cliente/Salvar" method="post">
                    <input type="hidden" name="Id" value="@(Model?.Id ?? 0)" />

                    <div class="mb-3">
                        <label class="form-label font-monospace small text-muted">Nome</label>
                        <input type="text" name="Nome" class="form-control" value="@Model?.Nome" required placeholder="Digite o nome..." />
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-monospace small text-muted">Email</label>
                        <input type="email" name="Email" class="form-control" value="@Model?.Email" required placeholder="exemplo@email.com" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-monospace small text-muted">Telefone</label>
                        <input type="text" name="Telefone" class="form-control" value="@Model?.Telefone" required placeholder="(00) 00000-0000" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100 fw-bold">
                            @(eEdicao ? "Atualizar" : "Cadastrar")
                        </button>
                        @if (eEdicao)
                        {
                            <a href="/Cliente" class="btn btn-outline-secondary">Cancelar</a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Tabela Estilizada -->
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white fw-bold">
                Lista de Clientes
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Nome</th>
                                <th>Email</th>
                                <th>Telefone</th>
                                <th>Cadastro</th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                    @if (clientes != null && clientes.Any())
                    {
                        foreach (var item in clientes)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">#@item.Id</span></td>
                                <td class="fw-semibold">@item.Nome</td>
                                <td>@item.Email</td>
                                <td>@item.Telefone</td>
                                <small class="text-muted"><td>@item.DataCadastro.ToString("g")</td></small>
                                <td class="text-center">
                                    <a href="/Cliente/Index?editId=@item.Id" class="btn btn-sm btn-outline-warning me-1">Editar</a>
                                    <form action="/Cliente/Excluir" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Deseja realmente excluir?')">Excluir</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">Nenhum cliente cadastrado.</td>
                            </tr>
                    }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>