@model trabalhoav1.Models.Produto

@{
    Layout = "_Layout";
    var produtos = ViewBag.Produtos as IEnumerable<trabalhoav1.Models.Produto>;
    bool eEdicao = Model != null && Model.Id > 0;
}

<div class="row g-4">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white fw-bold">
                @(eEdicao ? "Editar Produto" : "Cadastrar Produto")
            </div>
            <div class="card-body">
                <form action="/Produto/Salvar" method="post">
                    <input type="hidden" name="Id" value="@(Model?.Id ?? 0)" />

                    <div class="mb-3">
                        <label class="form-label font-monospace small text-muted">Nome do Produto</label>
                        <input type="text" name="Nome" class="form-control" value="@Model?.Nome" required />
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label font-monospace small text-muted">Preço (R$)</label>
                            <input type="number" step="0.01" name="Preco" class="form-control" value="@(Model?.Preco != 0 ? Model?.Preco : "")" required />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label font-monospace small text-muted">Estoque</label>
                            <input type="number" name="QuantidadeEstoque" class="form-control" value="@(Model?.QuantidadeEstoque != 0 ? Model?.QuantidadeEstoque : "")" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-monospace small text-muted">Categoria</label>
                        <input type="text" name="Categoria" class="form-control" value="@Model?.Categoria" required />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success w-100 fw-bold">
                            @(eEdicao ? "Atualizar" : "Cadastrar")
                        </button>
                        @if (eEdicao)
                        {
                            <a href="/Produto" class="btn btn-outline-secondary">Cancelar</a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white fw-bold">
                Lista de Produtos
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Nome</th>
                                <th>Preço</th>
                                <th>Estoque</th>
                                <th>Categoria</th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                    @if (produtos != null && produtos.Any())
                    {
                        foreach (var item in produtos)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">#@item.Id</span></td>
                                <td class="fw-semibold">@item.Nome</td>
                                <td class="text-success fw-bold">R$ @item.Preco.ToString("N2")</td>
                                <td><span class="badge bg-info text-dark">@item.QuantidadeEstoque un</span></td>
                                <td>@item.Categoria</td>
                                <td class="text-center">
                                    <a href="/Produto/Index?editId=@item.Id" class="btn btn-sm btn-outline-warning me-1">Editar</a>
                                    <form action="/Produto/Excluir" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Deseja realmente excluir?')">Excluir</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">Nenhum produto cadastrado.</td>
                            </tr>
                    }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>